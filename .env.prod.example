# ── Production secrets — copy to .env.prod and fill, then never commit ──────
#   cp .env.prod.example .env.prod   (.env.prod is gitignored)

# ── MySQL ───────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-strong-root
DB_DATABASE=line_knowledge
DB_USERNAME=line
DB_PASSWORD=change-me-strong

# ── Laravel management ──────────────────────────────────────────────────
# Generate once with: docker compose -f docker-compose.prod.yml run --rm management php artisan key:generate --show
APP_KEY=
APP_URL=https://your-domain-or-vm-ip
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin

# Shared secret between bot and management (bot uses it as KNOWLEDGE/ANALYTICS token).
# Any long random string, e.g. output of: openssl rand -hex 32
BOT_API_TOKEN=

# ── LINE bot ────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview
AI_TIMEOUT_SECONDS=20
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── Grafana ─────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change-me-grafana
