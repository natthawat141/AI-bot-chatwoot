# Pin before each tested upgrade. Current scaffold pin: 2026-08-08.
CHATWOOT_VERSION=v4.16.2-ce
CHATWOOT_PORT=3000

FRONTEND_URL=http://localhost:3000
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
SECRET_KEY_BASE=change-me-use-a-long-random-alphanumeric-value

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change-me-postgres-password

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=change-me-redis-password

DEFAULT_LOCALE=th
ACTIVE_STORAGE_SERVICE=local
ENABLE_ACCOUNT_SIGNUP=false

MAILER_SENDER_EMAIL=Chatwoot <accounts@example.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
