LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
OPENROUTER_API_KEY=
# Pin a concrete instruct model — avoid "openrouter/free" (auto-router can pick
# reasoning/low-quality models that dump chain-of-thought into replies) and avoid
# reasoning models (e.g. *-r1, gpt-5-mini) that return empty content here.
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview
AI_TIMEOUT_SECONDS=20
ANALYTICS_API_URL=http://127.0.0.1:8001
ANALYTICS_API_TOKEN=
ANALYTICS_TIMEOUT_SECONDS=3
KNOWLEDGE_API_URL=http://127.0.0.1:8001
KNOWLEDGE_API_TOKEN=
KNOWLEDGE_TIMEOUT_SECONDS=5
KNOWLEDGE_CACHE_SECONDS=60
NGROK_AUTHTOKEN=
